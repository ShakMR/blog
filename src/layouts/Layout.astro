---
import '../styles/global.scss';
import { getMessages, resolveRequestLocale } from '../lib/i18n';
import { getAccessTokenFromCookies, getAuthSessionContext } from '../lib/auth/session';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = 'A poc a poc i amb bona lletra',
  description = 'Blog de relatos cortos.',
  robots = 'index,follow',
} = Astro.props;

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const accessToken = getAccessTokenFromCookies(Astro.cookies);
const session = accessToken ? await getAuthSessionContext(accessToken) : null;
const nextPath = `${Astro.url.pathname}${Astro.url.search}`;
const profileHref = session ? '/me' : `/auth/login?next=${encodeURIComponent(nextPath)}`;

const localeChips = [
  { value: 'es', label: 'ESP', flag: '🇪🇸' },
  { value: 'ca', label: 'CAT', flag: '🇦🇩' },
  { value: 'en', label: 'ENG', flag: '🇬🇧' },
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-grid">
        <a class="brand" href="/">A poc a poc i amb bona lletra</a>
        <nav>
          <ul>
            <li><a href="/">{t.nav.latestStories}</a></li>
            <li><a href="/authors">{t.nav.authors}</a></li>
            <li><a href="/about">{t.nav.about}</a></li>
            <li>
              <form id="language-form" method="post" action="/api/i18n/locale" class="locale-form">
                <input type="hidden" name="next" value={nextPath} />
                <button type="submit" name="submit" hidden/>
                <select id='locale-selector' class="locale-chips" name="locale" onchange="">
                  {localeChips.map((option) => (
                    <option
                      value={option.value}
                      class:list={['chip', { active: option.value === locale }]}
                      selected={locale === option.value}
                    >
                      <span>{option.flag}</span>
                      <span>{option.label}</span>
                    </option>
                  ))}
                </select>
              </form>
            </li>
            <li>
              <a
                href={profileHref}
                class:list={['profile-link', { auth: Boolean(session) }]}
                aria-label={session ? `${t.nav.signedInAs}: ${session.user.email}` : t.nav.login}
                title={session ? `${t.nav.signedInAs}: ${session.user.email}` : t.nav.login}
              >
                <span class="profile-icon" aria-hidden="true"></span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  document.getElementById('locale-selector')?.addEventListener('change', () => {
    document.getElementsByName('submit')[0]?.click();
  })
</script>

<style lang="scss">
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--color-bg) 86%, white 14%);
  }

  .header-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: var(--space-4);
  }

  .brand {
    font-family: var(--font-display);
    text-decoration: none;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }
  
  select {
    background-color: transparent;
    border: 0;
  }

  nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
    flex-wrap: wrap;
  }

  nav a,
  nav button {
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--transition-base);
    background: transparent;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  nav a:hover,
  nav button:hover {
    color: var(--color-accent);
  }

  .locale-form {
    display: inline-flex;
    align-items: center;
  }

  .locale-chips {
    display: inline-flex;
    gap: 0.35rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2rem 0.45rem;
    color: var(--color-text-muted);
    background: #fff;
    font-size: 0.75rem;
  }

  .chip.active {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-bg-accent) 75%, #fff 25%);
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fff;
  }

  .profile-icon {
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid currentColor;
    border-radius: 999px;
    position: relative;
    display: inline-block;
    margin-top: -10px;
  }

  .profile-icon::after {
    content: '';
    position: absolute;
    width: 1rem;
    height: 0.55rem;
    border: 2px solid currentColor;
    border-top: none;
    border-radius: 0 0 999px 999px;
    left: 50%;
    transform: translateX(-50%) rotate(180deg);
    bottom: -0.75rem;
  }

  .profile-link.auth {
    color: #fff;
    background: linear-gradient(120deg, #8f4521, #bc6d3d);
    border-color: transparent;
  }

  .profile-link.auth:hover {
    color: #fff;
  }

  @media (max-width: 860px) {
    .header-grid {
      flex-direction: column;
      align-items: flex-start;
      padding-block: var(--space-3);
    }

    nav ul {
      row-gap: var(--space-2);
    }
  }
</style>
