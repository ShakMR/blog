---
import '../styles/global.scss';
import { siteConfig } from '../config/site';
import { getMessages, resolveRequestLocale } from '../lib/i18n';
import { getAccessTokenFromCookies, getAuthSessionContext } from '../lib/auth/session';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = 'A poc a poc i amb bona lletra',
  description = 'Blog de relatos cortos.',
  robots = 'index,follow',
} = Astro.props;

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const accessToken = getAccessTokenFromCookies(Astro.cookies);
const session = accessToken ? await getAuthSessionContext(accessToken) : null;
const isAuthor = session?.profile?.role === 'author' || session?.profile?.role === 'admin';
const nextPath = `${Astro.url.pathname}${Astro.url.search}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-grid">
        <a class="brand" href="/">A poc a poc i amb bona lletra</a>
        <nav>
          <ul>
            <li><a href="/">{t.nav.home}</a></li>
            <li><a href="/stories">{t.nav.latestStories}</a></li>
            <li><a href="/authors">{t.nav.authors}</a></li>
            <li><a href="/about">{t.nav.about}</a></li>
            {session ? (
              <>
                {isAuthor && <li><a href="/author">{t.nav.authorSpace}</a></li>}
                <li class="auth-indicator">{t.nav.signedInAs}: {session.user.email}</li>
                <li>
                  <form method="post" action="/api/auth/logout" class="inline-form">
                    <button type="submit">{t.nav.logout}</button>
                  </form>
                </li>
              </>
            ) : (
              <li><a href={`/auth/login?next=${encodeURIComponent(nextPath)}`}>{t.nav.login}</a></li>
            )}
            <li>
              <form method="post" action="/api/i18n/locale" class="inline-form locale-form">
                <input type="hidden" name="next" value={nextPath} />
                <label for="locale-selector">{t.nav.language}</label>
                <select id="locale-selector" name="locale" onchange="this.form.submit()">
                  {siteConfig.locales.map((option) => (
                    <option value={option} selected={option === locale}>
                      {t.localeNames[option]}
                    </option>
                  ))}
                </select>
              </form>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style lang="scss">
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--color-bg) 86%, white 14%);
  }

  .header-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: var(--space-4);
  }

  .brand {
    font-family: var(--font-display);
    text-decoration: none;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }

  nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
    flex-wrap: wrap;
  }

  nav a,
  nav button {
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--transition-base);
    background: transparent;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  nav a:hover,
  nav button:hover {
    color: var(--color-accent);
  }

  .auth-indicator {
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .inline-form {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .locale-form label {
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .locale-form select {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: #fff;
    font: inherit;
    padding: 0.2rem 0.4rem;
  }

  @media (max-width: 860px) {
    .header-grid {
      flex-direction: column;
      align-items: flex-start;
      padding-block: var(--space-3);
    }

    nav ul {
      row-gap: var(--space-2);
    }
  }
</style>
