---
import Layout from '../../layouts/Layout.astro';
import { getMessages } from '../../lib/i18n';

const t = getMessages('es');
---

<Layout title="Inicio | A poc a poc i amb bona lletra" description={t.home.subtitle}>
  <section class="container locale-page">
    <h1>{t.home.title}</h1>
    <p>{t.home.subtitle}</p>
  </section>
</Layout>

<style>
  .locale-page {
    padding-block: 4rem;
  }
</style>
