---
import Layout from '../layouts/Layout.astro';
import AuthorGrid from '../components/content/AuthorGrid.astro';
import PageSection from '../components/layout/PageSection.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { getPublicAuthors } from '../lib/authors/public';
import { getMessages, resolveRequestLocale } from '../lib/i18n';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);
const typedAuthors = await getPublicAuthors();
---

<Layout title={`${t.authorsPage.title} | A poc a poc i amb bona lletra`} description={t.authorsPage.title}>
  <PageSection class="authors-page">
    <PageHeader title={t.authorsPage.title} />

    {typedAuthors.length === 0 ? (
      <EmptyState text={t.authorsPage.placeholder} />
    ) : (
      <AuthorGrid authors={typedAuthors} bioFallback={t.stories.authorBioFallback} />
    )}
  </PageSection>
</Layout>

<style lang="scss">
  .authors-page {
    padding-block: var(--space-12);
    display: grid;
    gap: var(--space-6);
  }
</style>
