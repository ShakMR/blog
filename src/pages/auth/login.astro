---
import Layout from '../../layouts/Layout.astro';
import PageSection from '../../components/layout/PageSection.astro';
import FormField from '../../components/ui/FormField.astro';
import Message from '../../components/ui/Message.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SubmitButton from '../../components/ui/SubmitButton.astro';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const error = Astro.url.searchParams.get('error');
const status = Astro.url.searchParams.get('status');
const next = Astro.url.searchParams.get('next') ?? '/author';

const errorMessage =
  error === 'missing_credentials'
    ? t.auth.errorMissing
    : error === 'invalid_credentials'
      ? t.auth.errorInvalid
      : null;

const statusMessage = status === 'logged_out' ? t.auth.statusLoggedOut : null;
---

<Layout title={`${t.auth.title} | A poc a poc i amb bona lletra`} description={t.auth.subtitle}>
  <PageSection class="login-page">
    <div class="login-card">
      <PageHeader title={t.auth.title} eyebrow={t.auth.privateArea} description={t.auth.subtitle} />

      {errorMessage && <Message text={errorMessage} tone="error" />}
      {statusMessage && <Message text={statusMessage} tone="ok" />}

      <form method="post" action="/api/auth/login" class="login-form">
        <input type="hidden" name="next" value={next} />

        <FormField label={t.auth.email} for="email">
          <input id="email" name="email" type="email" required autocomplete="email" />
        </FormField>

        <FormField label={t.auth.password} for="password">
          <input id="password" name="password" type="password" required autocomplete="current-password" />
        </FormField>

        <SubmitButton text={t.auth.submit} />
      </form>
    </div>
  </PageSection>
</Layout>

<style lang="scss">
  .login-page {
    padding-block: var(--space-12);
    display: grid;
    place-items: center;
  }

  .login-card {
    width: min(28rem, 100%);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .login-form {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  input {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.8rem;
    font: inherit;
    background: #fff;
  }

  :global(.submit-button) {
    margin-top: var(--space-2);
  }
</style>
