---
import Layout from '../../layouts/Layout.astro';
import StoryFeed from '../../components/content/StoryFeed.astro';
import PageSection from '../../components/layout/PageSection.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getPublicAuthorBySlug } from '../../lib/authors/public';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';
import { createServerSupabaseClient } from '../../lib/supabase/server';
import type { StoryRecord } from '../../lib/stories/types';
import { getAuthorNoun } from '../../lib/authors/utils';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const slug = Astro.params.slug;
const typedAuthor = slug ? await getPublicAuthorBySlug(slug) : null;

if (!typedAuthor) {
  Astro.response.status = 404;
}
const supabase = createServerSupabaseClient();
const { data: stories = [] } = typedAuthor
  ? await supabase
      .from('stories')
      .select('*')
      .eq('author_id', typedAuthor.id)
      .eq('status', 'published')
      .order('published_at', { ascending: false })
  : { data: [] };

const typedStories = stories as StoryRecord[];
const authorById = new Map(typedAuthor ? [[typedAuthor.id, typedAuthor]] : []);
const authorTitle = typedAuthor?.display_name || (typedAuthor ? `@${typedAuthor.slug}` : '');
const authorBio = typedAuthor?.bio.trim() || t.stories.authorBioFallback;
---

<Layout
  title={typedAuthor ? `${typedAuthor.display_name || `@${typedAuthor.slug}`} | A poc a poc i amb bona lletra` : t.stories.notFound}
  description={typedAuthor?.bio || t.stories.authorBioFallback}
>
  {typedAuthor ? (
    <>
      <PageSection class="author-profile-header">
        <PageHeader
          eyebrow={getAuthorNoun(locale, typedAuthor.grammatical_gender)}
          title={authorTitle}
          description={`@${typedAuthor.slug}`}
        >
          <span class="bio">{authorBio}</span>
        </PageHeader>
      </PageSection>

      <StoryFeed
        title={t.stories.latestTitle}
        emptyLabel={t.stories.empty}
        stories={typedStories}
        authors={authorById}
        locale={locale}
        labels={t.stories}
      />
    </>
  ) : (
    <PageSection class="author-profile-header">
      <EmptyState text={t.stories.notFound} />
    </PageSection>
  )}
</Layout>

<style lang="scss">
  :global(.author-profile-header) {
    padding-top: var(--space-12);
  }

  .bio {
    display: block;
    max-width: 48rem;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  :global(.feed) {
    margin-top: var(--space-8);
  }
</style>
