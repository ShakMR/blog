---
import StoryCard from '../components/StoryCard.astro';
import Layout from '../layouts/Layout.astro';
import Divider, { Variants } from '../components/Divider.astro';
import { getPublicAuthorsByIds } from '../lib/authors/public';
import { getAuthorNoun } from '../lib/authors/utils';
import { getMessages, resolveRequestLocale } from '../lib/i18n';
import { createServerSupabaseClient } from '../lib/supabase/server';
import type { StoryRecord } from '../lib/stories/types';
import { formatDate, getStoryExcerpt, toPublicCoverUrl } from '../lib/stories/utils';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const supabase = createServerSupabaseClient();
const { data: stories = [] } = await supabase
  .from('stories')
  .select('*')
  .eq('status', 'published')
  .order('published_at', { ascending: false })
  .limit(24);

const typedStories = stories as StoryRecord[];
const authorIds = [...new Set(typedStories.map((story) => story.author_id))];
const authorById = await getPublicAuthorsByIds(authorIds);
---

<Layout title="A poc a poc i amb bona lletra" description={t.home.subtitle}>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">{t.home.eyebrow}</p>
      <h1>{t.home.title}</h1>
      <p>{t.home.subtitle}</p>
    </div>
    <div class="hero-mark">
      <img
        src="/img/brand/logo-300.png"
        alt="Logotipo de A poc a poc i amb bona lletra"
        width="220"
        height="220"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <section class="container feed">
    <h2>{t.home.latestTitle}</h2>
    {typedStories.length === 0 ? (
      <p class="empty-state">{t.home.empty}</p>
    ) : (
      <ul class="stories-grid">
        {typedStories.map((story) => (
          <li>
            {
              (() => {
                const author = authorById.get(story.author_id);
                const authorName = author?.display_name?.trim() || (author ? `@${author.slug}` : null);
                return (
            <StoryCard
              title={story.title}
              subtitle={story.subtitle}
              excerpt={getStoryExcerpt(story.body_html, 145) || t.stories.excerptFallback}
              coverUrl={toPublicCoverUrl(story.cover_image_path)}
              coverAlt={`Portada de ${story.title}`}
              titleHref={`/stories/${story.slug}`}
              authorLabel={author ? getAuthorNoun(locale, author.grammatical_gender) : t.stories.author}
              authorValue={authorName}
              authorHref={author ? `/authors/${author.slug}` : null}
              publishedAtLabel={t.stories.publishedAt}
              publishedAtValue={formatDate(story.published_at, locale)}
              variant='row'
            />
                );
              })()
            }
            <Divider variant={Variants.LINE} />
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>

<style lang="scss">
  .hero {
    padding-block: var(--space-12) var(--space-8);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-6);
  }

  .eyebrow {
    color: var(--color-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    margin: 0;
  }

  h1 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4.25rem);
    line-height: 1.05;
  }

  p {
    max-width: 56ch;
    color: var(--color-text-muted);
  }

  .hero-mark {
    display: flex;
    justify-content: flex-end;
  }

  .hero-mark img {
    width: min(220px, 32vw);
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 20px 40px rgba(73, 37, 18, 0.12);
  }

  .feed {
    padding-bottom: var(--space-12);
  }

  .feed h2 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .stories-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill);
    justify-content: center;
    gap: var(--space-4);
  }

  .stories-grid li {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty-state {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-mark {
      justify-content: flex-start;
    }

    .hero-mark img {
      width: min(180px, 48vw);
    }
  }
</style>
