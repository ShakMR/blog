---
import StoryCard from '../components/StoryCard.astro';
import Layout from '../layouts/Layout.astro';
import { getMessages, resolveRequestLocale } from '../lib/i18n';
import { createServerSupabaseClient } from '../lib/supabase/server';
import type { StoryRecord } from '../lib/stories/types';
import { formatDate, toPublicCoverUrl } from '../lib/stories/utils';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const supabase = createServerSupabaseClient();
const { data: stories = [] } = await supabase
  .from('stories')
  .select('*')
  .eq('status', 'published')
  .order('published_at', { ascending: false })
  .limit(10);

const typedStories = stories as StoryRecord[];
const [featuredStory, ...restStories] = typedStories;
---

<Layout title="A poc a poc i amb bona lletra" description={t.home.subtitle}>
  <section class="hero container">
    <p class="eyebrow">{t.home.eyebrow}</p>
    <h1>{t.home.title}</h1>
    <p>{t.home.subtitle}</p>
    <p class="status">{t.home.status}</p>
  </section>

  <section class="container feed">
    <h2>{t.home.latestTitle}</h2>
    {!featuredStory ? (
      <p class="empty-state">{t.home.empty}</p>
    ) : (
      <>
        <StoryCard
          variant="row"
          title={featuredStory.title}
          subtitle={featuredStory.subtitle}
          coverUrl={toPublicCoverUrl(featuredStory.cover_image_path)}
          coverAlt={`Portada de ${featuredStory.title}`}
          titleHref={`/stories/${featuredStory.slug}`}
          statusLabel={t.home.featuredBadge}
          publishedAtLabel={t.stories.publishedAt}
          publishedAtValue={formatDate(featuredStory.published_at)}
          updatedAtLabel={t.stories.updatedAt}
          updatedAtValue={formatDate(featuredStory.updated_at)}
        />

        {restStories.length > 0 && (
          <ul class="feed-list">
            {restStories.map((story) => (
              <li>
                <StoryCard
                  title={story.title}
                  subtitle={story.subtitle}
                  coverAlt={`Portada de ${story.title}`}
                  titleHref={`/stories/${story.slug}`}
                  publishedAtLabel={t.stories.publishedAt}
                  publishedAtValue={formatDate(story.published_at)}
                  updatedAtLabel={t.stories.updatedAt}
                  updatedAtValue={formatDate(story.updated_at)}
                />
              </li>
            ))}
          </ul>
        )}
      </>
    )}
  </section>
</Layout>

<style lang="scss">
  .hero {
    padding-block: var(--space-12) var(--space-8);
  }

  .eyebrow {
    color: var(--color-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    margin: 0;
  }

  h1 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4.25rem);
    line-height: 1.05;
  }

  p {
    max-width: 56ch;
    color: var(--color-text-muted);
  }

  .feed {
    padding-bottom: var(--space-12);
  }

  .feed h2 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .feed-list {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-4);
  }

  .empty-state {
    margin: 0;
    color: var(--color-text-muted);
  }

  .status {
    margin-top: var(--space-3);
  }
</style>
