---
import BrandHero from '../components/content/BrandHero.astro';
import StoryFeed from '../components/content/StoryFeed.astro';
import Layout from '../layouts/Layout.astro';
import { getPublicAuthorsByIds } from '../lib/authors/public';
import { getMessages, resolveRequestLocale } from '../lib/i18n';
import { createServerSupabaseClient } from '../lib/supabase/server';
import type { StoryRecord } from '../lib/stories/types';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const supabase = createServerSupabaseClient();
const { data: stories } = await supabase
  .from('stories')
  .select('*')
  .eq('status', 'published')
  .order('published_at', { ascending: false })
  .limit(24);

const typedStories = (stories ?? []) as StoryRecord[];
const authorIds = [...new Set(typedStories.map((story) => story.author_id))];
const authorById = await getPublicAuthorsByIds(authorIds);
---

<Layout title="A poc a poc i amb bona lletra" description={t.home.subtitle}>
  <BrandHero
    eyebrow={t.home.eyebrow}
    title={t.home.title}
    subtitle={t.home.subtitle}
    imageSrc="/img/brand/logo-300.png"
    imageAlt="Logotipo de A poc a poc i amb bona lletra"
  />

  <StoryFeed
    title={t.home.latestTitle}
    emptyLabel={t.home.empty}
    stories={typedStories}
    authors={authorById}
    locale={locale}
    labels={t.stories}
  />
</Layout>
