---
import Layout from '../layouts/Layout.astro';
import { createServerSupabaseClient } from '../lib/supabase/server';
import { formatDate, toPublicCoverUrl } from '../lib/stories/utils';
import type { StoryRecord } from '../lib/stories/types';
import { getMessages } from '../lib/i18n';

const t = getMessages('es');
const supabase = createServerSupabaseClient();
const { data: stories = [] } = await supabase
  .from('stories')
  .select('*')
  .eq('status', 'published')
  .order('published_at', { ascending: false })
  .limit(10);

const typedStories = stories as StoryRecord[];
const [featuredStory, ...restStories] = typedStories;
const featuredCoverUrl = featuredStory ? toPublicCoverUrl(featuredStory.cover_image_path) : null;
---

<Layout title="A poc a poc i amb bona lletra" description={t.home.subtitle}>
  <section class="hero container">
    <p class="eyebrow">Base v0.1</p>
    <h1>{t.home.title}</h1>
    <p>{t.home.subtitle}</p>
    <div class="cta-row">
      <a class="button" href="/stories">{t.home.cta}</a>
      <span>{t.home.status}</span>
    </div>
  </section>

  <section class="container feed">
    <h2>Últimas publicaciones</h2>
    {!featuredStory ? (
      <p class="empty-state">Aún no hay historias publicadas.</p>
    ) : (
      <>
        <article class="featured">
          {featuredCoverUrl && <img src={featuredCoverUrl} alt={`Portada de ${featuredStory.title}`} loading="lazy" />}
          <div class="featured-content">
            <p class="badge">Más reciente</p>
            <h3><a href={`/stories/${featuredStory.slug}`}>{featuredStory.title}</a></h3>
            <p>{featuredStory.subtitle}</p>
            <p class="meta">Publicada: {formatDate(featuredStory.published_at)}</p>
            <p class="meta">Última edición: {formatDate(featuredStory.updated_at)}</p>
          </div>
        </article>

        {restStories.length > 0 && (
          <ul class="feed-list">
            {restStories.map((story) => (
              <li>
                <h3><a href={`/stories/${story.slug}`}>{story.title}</a></h3>
                <p>{story.subtitle}</p>
                <p class="meta">Publicada: {formatDate(story.published_at)}</p>
                <p class="meta">Última edición: {formatDate(story.updated_at)}</p>
              </li>
            ))}
          </ul>
        )}
      </>
    )}
  </section>
</Layout>

<style lang="scss">
  .hero {
    padding-block: var(--space-12) var(--space-8);
  }

  .eyebrow {
    color: var(--color-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
  }

  h1 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4.25rem);
    line-height: 1.05;
  }

  p {
    max-width: 56ch;
    color: var(--color-text-muted);
  }

  .cta-row {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .button {
    border-radius: 999px;
    padding: 0.7rem 1.2rem;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(120deg, #8f4521, #bc6d3d);
    box-shadow: var(--shadow-soft);
  }

  .feed {
    padding-bottom: var(--space-12);
  }

  .feed h2 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 320px) 1fr;
    gap: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
  }

  .featured img {
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
  }

  .featured-content {
    padding: var(--space-4);
  }

  .badge {
    margin: 0;
    width: fit-content;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: #7f3025;
  }

  .featured h3,
  .feed-list h3 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
  }

  .featured h3 a,
  .feed-list h3 a {
    text-decoration: none;
  }

  .feed-list {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-4);
  }

  .feed-list li {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-4);
  }

  .meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .empty-state {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
</style>
