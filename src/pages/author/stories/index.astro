---
import AuthorStoryList from '../../../components/content/AuthorStoryList.astro';
import PageSection from '../../../components/layout/PageSection.astro';
import ButtonLink from '../../../components/ui/ButtonLink.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import Message from '../../../components/ui/Message.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import {
  getAccessTokenFromCookies,
  getAuthenticatedAuthorContext,
} from '../../../lib/auth/session';
import { getMessages, resolveRequestLocale } from '../../../lib/i18n';
import { createServerSupabaseClient } from '../../../lib/supabase/server';
import type { StoryRecord } from '../../../lib/stories/types';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const accessToken = getAccessTokenFromCookies(Astro.cookies);
if (!accessToken) {
  return Astro.redirect(`/auth/login?next=${encodeURIComponent('/author/stories')}`);
}

const context = await getAuthenticatedAuthorContext(accessToken);
if (!context) {
  return Astro.redirect(`/auth/login?error=invalid_credentials&next=${encodeURIComponent('/author/stories')}`);
}

const authorClient = createServerSupabaseClient({ accessToken });
const { data: stories = [] } = await authorClient
  .from('stories')
  .select('*')
  .eq('author_id', context.profile.id)
  .order('updated_at', { ascending: false });

const typedStories = stories as StoryRecord[];
const status = Astro.url.searchParams.get('status');
const error = Astro.url.searchParams.get('error');
---

<Layout title={`${t.authorStories.title} | A poc a poc i amb bona lletra`} description={t.authorDashboard.description}>
  <PageSection class="author-stories-page">
    <div class="header-row">
      <PageHeader eyebrow={t.authorStories.eyebrow} title={t.authorStories.title} />
      <ButtonLink href="/author/stories/new" text={t.authorStories.newStory} variant="primary" />
    </div>

    {status && <Message text={`${t.authorStories.operationDone}: ${status}`} />}
    {error && <Message text={`${t.authorStories.operationFailed}: ${error}`} tone="error" />}

    {typedStories.length === 0 ? (
      <div class="empty-state">
        <EmptyState text={t.authorStories.empty} />
      </div>
    ) : (
      <AuthorStoryList stories={typedStories} locale={locale} labels={t.authorStories} />
    )}
  </PageSection>
</Layout>

<style lang="scss">
  .author-stories-page {
    padding-block: var(--space-12);
  }

  .header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  :global(.author-stories-page .message) {
    margin: 0 0 var(--space-4);
  }

  .empty-state {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
  }
</style>
