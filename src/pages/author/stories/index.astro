---
import Layout from '../../../layouts/Layout.astro';
import {
  getAccessTokenFromCookies,
  getAuthenticatedAuthorContext,
} from '../../../lib/auth/session';
import { createServerSupabaseClient } from '../../../lib/supabase/server';
import { formatDate, toPublicCoverUrl } from '../../../lib/stories/utils';
import type { StoryRecord } from '../../../lib/stories/types';

const accessToken = getAccessTokenFromCookies(Astro.cookies);
if (!accessToken) {
  return Astro.redirect('/auth/login?next=/author/stories');
}

const context = await getAuthenticatedAuthorContext(accessToken);
if (!context) {
  return Astro.redirect('/auth/login?error=invalid_credentials&next=/author/stories');
}

const authorClient = createServerSupabaseClient({ accessToken });
const { data: stories = [] } = await authorClient
  .from('stories')
  .select('*')
  .eq('author_id', context.profile.id)
  .order('updated_at', { ascending: false });

const typedStories = stories as StoryRecord[];
const status = Astro.url.searchParams.get('status');
const error = Astro.url.searchParams.get('error');
---

<Layout title="Mis historias | A poc a poc i amb bona lletra" description="Gestión de historias del autor.">
  <section class="container author-stories-page">
    <div class="header-row">
      <div>
        <p class="eyebrow">Autor</p>
        <h1>Mis historias</h1>
      </div>
      <a class="button" href="/author/stories/new">Nueva historia</a>
    </div>

    {status && <p class="message ok">Operación completada: {status}</p>}
    {error && <p class="message error">No se pudo completar la operación: {error}</p>}

    {typedStories.length === 0 ? (
      <div class="empty-state">
        <p>Aún no tienes historias. Crea la primera.</p>
      </div>
    ) : (
      <ul class="stories-list">
        {typedStories.map((story) => {
          const coverUrl = toPublicCoverUrl(story.cover_image_path);
          const draftUrl = `/draft/${story.draft_access_token}`;
          const publicUrl = `/stories/${story.slug}`;
          return (
            <li>
              {coverUrl && <img src={coverUrl} alt="Portada" loading="lazy" />}
              <div class="story-content">
                <p class="pill">{story.status}</p>
                <h2>{story.title}</h2>
                <p>{story.subtitle}</p>
                <p class="meta">Última edición: {formatDate(story.updated_at)}</p>
                {story.published_at && <p class="meta">Publicación: {formatDate(story.published_at)}</p>}
                <div class="actions">
                  <a href={`/author/stories/${story.id}/edit`}>Editar</a>
                  <a href={draftUrl}>Ver borrador</a>
                  {story.status === 'published' && <a href={publicUrl}>Ver publicada</a>}
                  <form method="post" action="/api/author/stories/delete">
                    <input type="hidden" name="storyId" value={story.id} />
                    <button type="submit">Eliminar</button>
                  </form>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</Layout>

<style lang="scss">
  .author-stories-page {
    padding-block: var(--space-12);
  }

  .header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .button {
    border-radius: 999px;
    padding: 0.7rem 1rem;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(120deg, #8f4521, #bc6d3d);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
  }

  .stories-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .stories-list li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
  }

  .stories-list img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 180px;
  }

  .story-content {
    padding: var(--space-4);
  }

  .story-content h2 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
  }

  .pill {
    display: inline-flex;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: #7f3025;
  }

  .meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .actions a,
  .actions button {
    font: inherit;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    color: var(--color-accent);
    text-decoration: underline;
  }

  .message {
    padding: 0.7rem 0.8rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }

  .message.ok {
    background: #e5f6ea;
    color: #1f6a3d;
  }

  .message.error {
    background: #fbe5e1;
    color: #8f2c21;
  }

  .empty-state {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
  }

  @media (max-width: 720px) {
    .stories-list li {
      grid-template-columns: 1fr;
    }
  }
</style>
