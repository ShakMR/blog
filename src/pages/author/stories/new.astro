---
import StoryEditorForm from '../../../components/StoryEditorForm.astro';
import Layout from '../../../layouts/Layout.astro';
import {
  getAccessTokenFromCookies,
  getAuthenticatedAuthorContext,
} from '../../../lib/auth/session';
import { getMessages, resolveRequestLocale } from '../../../lib/i18n';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const accessToken = getAccessTokenFromCookies(Astro.cookies);
if (!accessToken) {
  return Astro.redirect('/auth/login?next=/author/stories/new');
}

const context = await getAuthenticatedAuthorContext(accessToken);
if (!context) {
  return Astro.redirect('/auth/login?error=invalid_credentials&next=/author/stories/new');
}
---

<Layout title={`${t.editor.newTitle} | A poc a poc i amb bona lletra`} description={t.authorDashboard.description}>
  <section class="container editor-page">
    <h1>{t.editor.newTitle}</h1>
    <a class="back-link" href="/author/stories">{t.editor.backToStories}</a>

    <StoryEditorForm action="/api/author/stories/save" submitLabel={t.editor.saveStory} labels={t.editor} />
  </section>
</Layout>

<style lang="scss">
  .editor-page {
    padding-block: var(--space-12);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
  }

  .back-link {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--color-accent);
  }
</style>
