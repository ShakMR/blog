---
import Layout from '../../layouts/Layout.astro';
import {
  getAccessTokenFromCookies,
  getAuthenticatedAuthorContext,
} from '../../lib/auth/session';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const accessToken = getAccessTokenFromCookies(Astro.cookies);

if (!accessToken) {
  return Astro.redirect('/auth/login?next=/author');
}

const context = await getAuthenticatedAuthorContext(accessToken);

if (!context) {
  return Astro.redirect('/auth/login?error=invalid_credentials&next=/author');
}

const { profile, user } = context;
const isAdmin = profile.role === 'admin';
const adminStatus = Astro.url.searchParams.get('admin_status');
const createdEmail = Astro.url.searchParams.get('created');
const createdSlug = Astro.url.searchParams.get('slug');
const adminError = Astro.url.searchParams.get('admin_error');
const invitePreviewCookie = Astro.cookies.get('admin-invite-preview')?.value ?? null;

let invitePreview: { toEmail: string; subject: string; text: string } | null = null;

if (invitePreviewCookie) {
  try {
    invitePreview = JSON.parse(invitePreviewCookie) as { toEmail: string; subject: string; text: string };
  } catch {
    invitePreview = null;
  }

  Astro.cookies.delete('admin-invite-preview', {
    path: '/author',
  });
}
---

<Layout title={`${t.nav.authorSpace} | A poc a poc i amb bona lletra`} description={t.authorDashboard.description}>
  <section class="container author-page">
    <p class="eyebrow">{t.authorDashboard.eyebrow}</p>
    <h1>{t.authorDashboard.welcome}, {profile.display_name}</h1>
    <p>{t.authorDashboard.description}</p>

    <div class="quick-actions">
      <a href="/author/stories">{t.authorDashboard.manageStories}</a>
      <a href="/author/stories/new">{t.authorDashboard.newStory}</a>
    </div>

    <dl class="meta">
      <div>
        <dt>{t.authorDashboard.role}</dt>
        <dd>{profile.role}</dd>
      </div>
      <div>
        <dt>{t.authorDashboard.email}</dt>
        <dd>{user.email}</dd>
      </div>
      <div>
        <dt>{t.authorDashboard.language}</dt>
        <dd>{profile.locale}</dd>
      </div>
    </dl>

    <form method="post" action="/api/auth/logout">
      <button type="submit">{t.nav.logout}</button>
    </form>

    {isAdmin && (
      <section class="admin-users">
        <div class="admin-users__header">
          <p class="eyebrow">Admin</p>
          <h2>{t.adminUsers.title}</h2>
          <p>{t.adminUsers.description}</p>
        </div>

        {adminStatus === 'user_created' && createdEmail && (
          <p class="message ok">
            {t.adminUsers.success}: <strong>{createdEmail}</strong> (<code>/{createdSlug ?? '-'}</code>).
            {' '}
            {t.adminUsers.successPendingEmail}
          </p>
        )}

        {adminError === 'forbidden' && <p class="message error">{t.adminUsers.errorForbidden}</p>}
        {adminError === 'invalid_payload' && <p class="message error">{t.adminUsers.errorInvalid}</p>}
        {adminError === 'email_taken' && <p class="message error">{t.adminUsers.errorEmailTaken}</p>}
        {adminError === 'create_failed' && <p class="message error">{t.adminUsers.errorGeneric}</p>}

        <form class="admin-users__form" method="post" action="/api/admin/users/create">
          <label>
            <span>{t.adminUsers.email}</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>

          <label>
            <span>{t.adminUsers.displayName}</span>
            <input name="displayName" type="text" required maxlength="80" />
          </label>

          <label>
            <span>{t.adminUsers.slug}</span>
            <input name="slug" type="text" maxlength="80" />
            <small>{t.adminUsers.slugHint}</small>
          </label>

          <label>
            <span>{t.adminUsers.locale}</span>
            <select name="locale" required>
              <option value="es">Español</option>
              <option value="ca">Català</option>
              <option value="en">English</option>
            </select>
          </label>

          <label>
            <span>{t.adminUsers.temporaryPassword}</span>
            <input name="password" type="password" required minlength="10" autocomplete="new-password" />
          </label>

          <button type="submit">{t.adminUsers.submit}</button>
        </form>

        {invitePreview && (
          <div class="admin-users__preview">
            <h3>{t.adminUsers.manualEmailTitle}</h3>
            <p>{t.adminUsers.manualEmailDescription}</p>

            <label>
              <span>{t.adminUsers.manualEmailTo}</span>
              <input type="text" value={invitePreview.toEmail} readonly />
            </label>

            <label>
              <span>{t.adminUsers.manualEmailSubject}</span>
              <input type="text" value={invitePreview.subject} readonly />
            </label>

            <label>
              <span>{t.adminUsers.manualEmailBody}</span>
              <textarea readonly rows={10}>{invitePreview.text}</textarea>
            </label>
          </div>
        )}
      </section>
    )}
  </section>
</Layout>

<style lang="scss">
  .author-page {
    padding-block: var(--space-12);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-size: 0.75rem;
  }

  h1 {
    margin-block: var(--space-2) var(--space-3);
    font-family: var(--font-display);
  }

  .meta {
    margin-block: var(--space-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-4);
  }

  .quick-actions {
    display: flex;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-6);
    flex-wrap: wrap;
  }

  .quick-actions a {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 0.85rem;
    text-decoration: none;
    color: var(--color-accent);
    background: var(--color-surface);
  }

  .meta div {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--color-surface);
  }

  dt {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
  }

  .admin-users {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .admin-users__header h2 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
  }

  .admin-users__form {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .admin-users__form label {
    display: grid;
    gap: 0.45rem;
  }

  .admin-users__form input,
  .admin-users__form select {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 0.9rem;
    font: inherit;
    background: #fff;
  }

  .admin-users__form small {
    color: var(--color-text-muted);
  }

  .admin-users__preview {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .admin-users__preview h3 {
    margin: 0;
    font-family: var(--font-display);
  }

  .admin-users__preview label {
    display: grid;
    gap: 0.45rem;
  }

  .message {
    margin: var(--space-4) 0 0;
    border-radius: var(--radius-md);
    padding: 0.8rem 0.95rem;
  }

  .message.ok {
    background: rgba(40, 132, 73, 0.1);
    color: #20592f;
  }

  .message.error {
    background: rgba(148, 46, 46, 0.1);
    color: #7d2020;
  }

  input[readonly],
  textarea[readonly] {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 0.9rem;
    font: inherit;
    background: rgba(255, 255, 255, 0.75);
    color: var(--color-text);
  }

  textarea[readonly] {
    resize: vertical;
    min-height: 14rem;
    white-space: pre-wrap;
  }

  button {
    border: none;
    border-radius: 999px;
    padding: 0.7rem 1rem;
    cursor: pointer;
    font: inherit;
    color: #fff;
    background: #7f3025;
  }
</style>
