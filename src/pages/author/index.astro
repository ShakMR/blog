---
import Layout from '../../layouts/Layout.astro';
import {
  getAccessTokenFromCookies,
  getAuthenticatedAuthorContext,
} from '../../lib/auth/session';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const accessToken = getAccessTokenFromCookies(Astro.cookies);

if (!accessToken) {
  return Astro.redirect('/auth/login?next=/author');
}

const context = await getAuthenticatedAuthorContext(accessToken);

if (!context) {
  return Astro.redirect('/auth/login?error=invalid_credentials&next=/author');
}

const { profile, user } = context;
---

<Layout title={`${t.nav.authorSpace} | A poc a poc i amb bona lletra`} description={t.authorDashboard.description}>
  <section class="container author-page">
    <p class="eyebrow">{t.authorDashboard.eyebrow}</p>
    <h1>{t.authorDashboard.welcome}, {profile.display_name}</h1>
    <p>{t.authorDashboard.description}</p>

    <div class="quick-actions">
      <a href="/author/stories">{t.authorDashboard.manageStories}</a>
      <a href="/author/stories/new">{t.authorDashboard.newStory}</a>
    </div>

    <dl class="meta">
      <div>
        <dt>{t.authorDashboard.role}</dt>
        <dd>{profile.role}</dd>
      </div>
      <div>
        <dt>{t.authorDashboard.email}</dt>
        <dd>{user.email}</dd>
      </div>
      <div>
        <dt>{t.authorDashboard.language}</dt>
        <dd>{profile.locale}</dd>
      </div>
    </dl>

    <form method="post" action="/api/auth/logout">
      <button type="submit">{t.nav.logout}</button>
    </form>
  </section>
</Layout>

<style lang="scss">
  .author-page {
    padding-block: var(--space-12);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-size: 0.75rem;
  }

  h1 {
    margin-block: var(--space-2) var(--space-3);
    font-family: var(--font-display);
  }

  .meta {
    margin-block: var(--space-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-4);
  }

  .quick-actions {
    display: flex;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-6);
    flex-wrap: wrap;
  }

  .quick-actions a {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 0.85rem;
    text-decoration: none;
    color: var(--color-accent);
    background: var(--color-surface);
  }

  .meta div {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--color-surface);
  }

  dt {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
  }

  button {
    border: none;
    border-radius: 999px;
    padding: 0.7rem 1rem;
    cursor: pointer;
    font: inherit;
    color: #fff;
    background: #7f3025;
  }
</style>
