---
import Layout from '../../layouts/Layout.astro';
import LatestStoryList from '../../components/content/LatestStoryList.astro';
import PageSection from '../../components/layout/PageSection.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import DefinitionGrid from '../../components/ui/DefinitionGrid.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Panel from '../../components/ui/Panel.astro';
import SubmitButton from '../../components/ui/SubmitButton.astro';
import {
  getAccessTokenFromCookies,
  getAuthenticatedAuthorContext,
} from '../../lib/auth/session';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';
import { createServerSupabaseClient } from '../../lib/supabase/server';
import type { StoryRecord } from '../../lib/stories/types';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const accessToken = getAccessTokenFromCookies(Astro.cookies);

if (!accessToken) {
  return Astro.redirect('/auth/login?next=/author');
}

const context = await getAuthenticatedAuthorContext(accessToken);

if (!context) {
  return Astro.redirect('/auth/login?error=invalid_credentials&next=/author');
}

const { profile, user } = context;
const isAdmin = profile.role === 'admin';
const authorClient = createServerSupabaseClient({ accessToken });
const { data: stories = [] } = await authorClient
  .from('stories')
  .select('*')
  .eq('author_id', profile.id)
  .order('updated_at', { ascending: false })
  .limit(5);

const latestStories = (stories ?? []) as StoryRecord[];
const profileItems = [
  { label: t.authorDashboard.role, value: profile.role },
  { label: t.authorDashboard.email, value: user.email ?? '' },
  { label: t.authorDashboard.language, value: profile.locale },
];
---

<Layout title={`${t.nav.authorSpace} | A poc a poc i amb bona lletra`} description={t.authorDashboard.description}>
  <PageSection class="author-page">
    <PageHeader
      eyebrow={t.authorDashboard.eyebrow}
      title={`${t.authorDashboard.welcome}, ${profile.display_name}`}
      description={t.authorDashboard.description}
    >
      <div class="quick-actions">
        <ButtonLink variant="primary" href="/author/stories/new" text={t.authorDashboard.newStory} />
        {isAdmin && <ButtonLink href="/author/admin/users/new" text={t.authorDashboard.createAuthor} />}
      </div>
    </PageHeader>

    <Panel title={t.authorDashboard.accountTitle}>
      <DefinitionGrid items={profileItems} />
    </Panel>

    <Panel>
      <LatestStoryList
        stories={latestStories}
        locale={locale}
        dashboardLabels={t.authorDashboard}
        storyLabels={t.authorStories}
      />
    </Panel>

    <form class="logout-form" method="post" action="/api/auth/logout">
      <SubmitButton text={t.nav.logout} variant="danger" />
    </form>
  </PageSection>
</Layout>

<style lang="scss">
  .author-page {
    padding-block: var(--space-12);
    display: grid;
    gap: var(--space-6);
  }

  .quick-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }

  .logout-form {
    margin-top: var(--space-2);
  }
</style>
