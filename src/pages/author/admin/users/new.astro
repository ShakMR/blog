---
import Layout from '../../../../layouts/Layout.astro';
import InvitePreview from '../../../../components/content/InvitePreview.astro';
import PageSection from '../../../../components/layout/PageSection.astro';
import PageHeader from '../../../../components/ui/PageHeader.astro';
import Message from '../../../../components/ui/Message.astro';
import FormField from '../../../../components/ui/FormField.astro';
import SubmitButton from '../../../../components/ui/SubmitButton.astro';
import TextLink from '../../../../components/ui/TextLink.astro';
import {
  getAccessTokenFromCookies,
  getAuthenticatedAuthorContext,
} from '../../../../lib/auth/session';
import { getMessages, resolveRequestLocale } from '../../../../lib/i18n';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);
const pagePath = '/author/admin/users/new';

const accessToken = getAccessTokenFromCookies(Astro.cookies);

if (!accessToken) {
  return Astro.redirect(`/auth/login?next=${encodeURIComponent(pagePath)}`);
}

const context = await getAuthenticatedAuthorContext(accessToken);

if (!context || context.profile.role !== 'admin') {
  return Astro.redirect('/author');
}

const adminStatus = Astro.url.searchParams.get('admin_status');
const emailed = Astro.url.searchParams.get('emailed') === '1';
const createdEmail = Astro.url.searchParams.get('created');
const createdSlug = Astro.url.searchParams.get('slug');
const adminError = Astro.url.searchParams.get('admin_error');
const invitePreviewCookie = Astro.cookies.get('admin-invite-preview')?.value ?? null;
const createdSlugLabel = `/${createdSlug ?? '-'}`;
const adminErrorMessages: Record<string, string> = {
  forbidden: t.adminUsers.errorForbidden,
  invalid_payload: t.adminUsers.errorInvalid,
  email_taken: t.adminUsers.errorEmailTaken,
  create_failed: t.adminUsers.errorGeneric,
};
const errorMessage = adminError ? adminErrorMessages[adminError] : null;

let invitePreview: { toEmail: string; subject: string; text: string } | null = null;

if (invitePreviewCookie) {
  try {
    invitePreview = JSON.parse(invitePreviewCookie) as { toEmail: string; subject: string; text: string };
  } catch {
    invitePreview = null;
  }

  Astro.cookies.delete('admin-invite-preview', {
    path: pagePath,
  });
}
---

<Layout title={`${t.adminUsers.title} | A poc a poc i amb bona lletra`} description={t.adminUsers.description}>
  <PageSection class="admin-users-page">
    <TextLink href="/author" text={t.adminUsers.backToDashboard} />

    <PageHeader eyebrow="Admin" title={t.adminUsers.title} description={t.adminUsers.description} />

    <div class="admin-users__messages">
      {adminStatus === 'user_created' && createdEmail && (
        <Message tone="ok">
          {t.adminUsers.success}: <strong>{createdEmail}</strong> (<code>{createdSlugLabel}</code>).
          {' '}
          {emailed ? t.adminUsers.successEmailed : t.adminUsers.successPendingEmail}
        </Message>
      )}
      {errorMessage && <Message text={errorMessage} tone="error" />}
    </div>

    <form class="admin-users__form" method="post" action="/api/admin/users/create">
      <FormField label={t.adminUsers.email}>
        <input name="email" type="email" required autocomplete="email" />
      </FormField>

      <FormField label={t.adminUsers.displayName}>
        <input name="displayName" type="text" required maxlength="80" />
      </FormField>

      <FormField label={t.adminUsers.slug} hint={t.adminUsers.slugHint}>
        <input name="slug" type="text" maxlength="80" />
      </FormField>

      <FormField label={t.adminUsers.locale}>
        <select name="locale" required>
          <option value="es">{t.localeNames.es}</option>
          <option value="ca">{t.localeNames.ca}</option>
          <option value="en">{t.localeNames.en}</option>
        </select>
      </FormField>

      <FormField label={t.adminUsers.temporaryPassword}>
        <input name="password" type="password" required minlength="10" autocomplete="new-password" />
      </FormField>

      <SubmitButton text={t.adminUsers.submit} variant="danger" />
    </form>

    {invitePreview && <InvitePreview preview={invitePreview} labels={t.adminUsers} />}
  </PageSection>
</Layout>

<style lang="scss">
  .admin-users-page {
    padding-block: var(--space-12);
  }

  .admin-users-page :global(.page-header) {
    margin-top: var(--space-5);
  }

  .admin-users-page :global(.page-header p) {
    max-width: 44rem;
  }

  .admin-users__messages,
  .admin-users__form {
    max-width: 42rem;
  }

  .admin-users__form {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .admin-users__form input,
  .admin-users__form select {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 0.9rem;
    font: inherit;
    background: #fff;
    color: var(--color-text);
  }

  :global(.submit-button) {
    justify-self: start;
  }
</style>
