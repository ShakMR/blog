---
import Layout from '../../layouts/Layout.astro';
import CommentsSection from '../../components/content/CommentsSection.astro';
import StoryArticle from '../../components/content/StoryArticle.astro';
import StoryKudos from '../../components/content/StoryKudos.astro';
import StoryPageShell from '../../components/layout/StoryPageShell.astro';
import { getPublicAuthorsByIds } from '../../lib/authors/public';
import type { CommentRecord } from '../../lib/comments/types';
import { getAboutAuthorLabel } from '../../lib/authors/utils';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';
import {
  hashKudosClientToken,
  isKudosEnabled,
  isValidKudosClientToken,
  KUDOS_CLIENT_COOKIE,
} from '../../lib/kudos/validation';
import { createServerSupabaseClient, createServiceRoleClient } from '../../lib/supabase/server';
import { formatDate, toPublicCoverUrl } from '../../lib/stories/utils';
import type { StoryRecord } from '../../lib/stories/types';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const slug = Astro.params.slug;
const supabase = createServerSupabaseClient();
const { data: story } = await supabase
  .from('stories')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .maybeSingle();

if (!story) {
  Astro.response.status = 404;
}

const typedStory = story as StoryRecord | null;
const typedAuthor = typedStory ? (await getPublicAuthorsByIds([typedStory.author_id])).get(typedStory.author_id) ?? null : null;
const coverUrl = typedStory ? toPublicCoverUrl(typedStory.cover_image_path) : null;
const authorLabel = typedAuthor ? getAboutAuthorLabel(locale, typedAuthor.grammatical_gender) : t.stories.aboutAuthor;
const authorName = typedAuthor?.display_name || (typedAuthor ? `@${typedAuthor.slug}` : '-');
const authorBio = typedAuthor?.bio?.trim() ? typedAuthor.bio : t.stories.authorBioFallback;
const { data: comments = [] } = typedStory?.comments_enabled
  ? await supabase
      .from('comments')
      .select('id, story_id, author_name, body, created_at')
      .eq('story_id', typedStory.id)
      .order('created_at', { ascending: true })
      .limit(100)
  : { data: [] };
const typedComments = (comments ?? []) as CommentRecord[];
let kudosCount = 0;
let hasSentKudos = false;
if (typedStory && isKudosEnabled(typedStory.kudos_visibility)) {
  const serviceClient = createServiceRoleClient();
  const { count = 0 } = await serviceClient
    .from('story_kudos')
    .select('id', { count: 'exact', head: true })
    .eq('story_id', typedStory.id);
  kudosCount = count ?? 0;

  const kudosToken = Astro.cookies.get(KUDOS_CLIENT_COOKIE)?.value;
  if (isValidKudosClientToken(kudosToken)) {
    const { data: existingKudos } = await serviceClient
      .from('story_kudos')
      .select('id')
      .eq('story_id', typedStory.id)
      .eq('client_hash', hashKudosClientToken(kudosToken))
      .maybeSingle();
    hasSentKudos = !!existingKudos;
  }
}
const commentStatus = Astro.url.searchParams.get('comment_status');
const commentError = Astro.url.searchParams.get('comment_error');
const kudosStatus = Astro.url.searchParams.get('kudos_status');
const kudosError = Astro.url.searchParams.get('kudos_error');
---

<Layout
  title={typedStory ? `${typedStory.title} | A poc a poc i amb bona lletra` : t.stories.notFound}
  description={typedStory?.subtitle ?? t.stories.notFound}
  image={coverUrl}
  type="article"
  robots={typedStory ? undefined : 'noindex,nofollow'}
>
  <StoryPageShell>
    <StoryArticle
      story={typedStory}
      notFoundLabel={t.stories.notFound}
      coverUrl={coverUrl}
      coverAlt={typedStory ? `Portada de ${typedStory.title}` : undefined}
      meta={typedStory ? `${t.stories.publishedAt}: ${formatDate(typedStory.published_at, locale)}` : undefined}
      authorLabel={authorLabel}
      authorName={authorName}
      authorHref={typedAuthor ? `/authors/${typedAuthor.slug}` : null}
      authorHandle={typedAuthor ? `@${typedAuthor.slug}` : null}
      authorBio={authorBio}
    />

    {typedStory && (
      <div class="story-feedback">
        {isKudosEnabled(typedStory.kudos_visibility) && (
          <StoryKudos
            storyId={typedStory.id}
            storySlug={typedStory.slug}
            visibility={typedStory.kudos_visibility}
            count={kudosCount}
            sent={hasSentKudos}
            labels={t.kudos}
            status={kudosStatus}
            error={kudosError}
          />
        )}

        <CommentsSection
          storyId={typedStory.id}
          storySlug={typedStory.slug}
          commentsEnabled={typedStory.comments_enabled}
          comments={typedComments}
          labels={t.comments}
          locale={locale}
          status={commentStatus}
          error={commentError}
        />
      </div>
    )}
  </StoryPageShell>
</Layout>

<style lang="scss">
  .story-feedback {
    max-width: 720px;
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: max-content max-content 1fr;
    gap: var(--space-3);
    align-items: center;
  }
</style>
