---
import Layout from '../../layouts/Layout.astro';
import { createServerSupabaseClient } from '../../lib/supabase/server';
import { formatDate, toPublicCoverUrl } from '../../lib/stories/utils';
import type { StoryRecord } from '../../lib/stories/types';

const slug = Astro.params.slug;
const supabase = createServerSupabaseClient();
const { data: story } = await supabase
  .from('stories')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .maybeSingle();

if (!story) {
  Astro.response.status = 404;
}

const typedStory = story as StoryRecord | null;
const coverUrl = typedStory ? toPublicCoverUrl(typedStory.cover_image_path) : null;
---

<Layout
  title={typedStory ? `${typedStory.title} | A poc a poc i amb bona lletra` : 'Historia no encontrada'}
  description={typedStory?.subtitle ?? 'Historia no encontrada'}
>
  <section class="container story-page">
    {typedStory ? (
      <article>
        {coverUrl && <img src={coverUrl} alt={`Portada de ${typedStory.title}`} class="cover" loading="lazy" />}
        <h1>{typedStory.title}</h1>
        <p class="subtitle">{typedStory.subtitle}</p>
        <p class="meta">Publicada: {formatDate(typedStory.published_at)}</p>
        <p class="meta">Última edición: {formatDate(typedStory.updated_at)}</p>

        <div class="tags">
          {typedStory.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>

        <div class="content" set:html={typedStory.body_html}></div>
      </article>
    ) : (
      <p>Historia no encontrada.</p>
    )}
  </section>
</Layout>

<style lang="scss">
  .story-page {
    padding-block: var(--space-12);
  }

  article {
    max-width: 720px;
  }

  .cover {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.3rem);
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .tags {
    margin-block: var(--space-4) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tags span {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-size: 0.8rem;
  }

  .content :global(p) {
    line-height: 1.8;
  }
</style>
