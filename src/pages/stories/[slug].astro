---
import Layout from '../../layouts/Layout.astro';
import StoryArticle from '../../components/content/StoryArticle.astro';
import PageSection from '../../components/layout/PageSection.astro';
import { getPublicAuthorsByIds } from '../../lib/authors/public';
import { getAboutAuthorLabel } from '../../lib/authors/utils';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';
import { createServerSupabaseClient } from '../../lib/supabase/server';
import { formatDate, toPublicCoverUrl } from '../../lib/stories/utils';
import type { StoryRecord } from '../../lib/stories/types';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const slug = Astro.params.slug;
const supabase = createServerSupabaseClient();
const { data: story } = await supabase
  .from('stories')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .maybeSingle();

if (!story) {
  Astro.response.status = 404;
}

const typedStory = story as StoryRecord | null;
const typedAuthor = typedStory ? (await getPublicAuthorsByIds([typedStory.author_id])).get(typedStory.author_id) ?? null : null;
const coverUrl = typedStory ? toPublicCoverUrl(typedStory.cover_image_path) : null;
const authorLabel = typedAuthor ? getAboutAuthorLabel(locale, typedAuthor.grammatical_gender) : t.stories.aboutAuthor;
const authorName = typedAuthor?.display_name || (typedAuthor ? `@${typedAuthor.slug}` : '-');
const authorBio = typedAuthor?.bio?.trim() ? typedAuthor.bio : t.stories.authorBioFallback;
---

<Layout
  title={typedStory ? `${typedStory.title} | A poc a poc i amb bona lletra` : t.stories.notFound}
  description={typedStory?.subtitle ?? t.stories.notFound}
>
  <PageSection class="story-page">
    <StoryArticle
      story={typedStory}
      notFoundLabel={t.stories.notFound}
      coverUrl={coverUrl}
      coverAlt={typedStory ? `Portada de ${typedStory.title}` : undefined}
      meta={typedStory ? `${t.stories.publishedAt}: ${formatDate(typedStory.published_at, locale)}` : undefined}
      authorLabel={authorLabel}
      authorName={authorName}
      authorHref={typedAuthor ? `/authors/${typedAuthor.slug}` : null}
      authorHandle={typedAuthor ? `@${typedAuthor.slug}` : null}
      authorBio={authorBio}
    />
  </PageSection>
</Layout>

<style lang="scss">
  .story-page {
    padding-block: var(--space-12);
  }
</style>
