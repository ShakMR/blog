---
import StoryCardGrid from '../../components/content/StoryCardGrid.astro';
import PageSection from '../../components/layout/PageSection.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublicAuthorsByIds } from '../../lib/authors/public';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';
import { createServerSupabaseClient } from '../../lib/supabase/server';
import type { StoryRecord } from '../../lib/stories/types';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const supabase = createServerSupabaseClient();
const { data: stories = [] } = await supabase
  .from('stories')
  .select('*')
  .eq('status', 'published')
  .order('published_at', { ascending: false })
  .limit(48);

const typedStories = (stories ?? []) as StoryRecord[];
const authorIds = [...new Set(typedStories.map((story) => story.author_id))];
const authorById = await getPublicAuthorsByIds(authorIds);
---

<Layout title={`${t.stories.latestTitle} | A poc a poc i amb bona lletra`} description={t.home.subtitle}>
  <PageSection class="stories-page">
    <PageHeader eyebrow={t.stories.eyebrow} title={t.stories.latestTitle} />

    {typedStories.length === 0 ? (
      <EmptyState text={t.stories.empty} />
    ) : (
      <StoryCardGrid stories={typedStories} authors={authorById} locale={locale} labels={t.stories} />
    )}
  </PageSection>
</Layout>

<style lang="scss">
  .stories-page {
    padding-block: var(--space-12);
    display: grid;
    gap: var(--space-6);
  }
</style>
