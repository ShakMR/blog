---
import Layout from '../../layouts/Layout.astro';
import PageSection from '../../components/layout/PageSection.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import DefinitionGrid from '../../components/ui/DefinitionGrid.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SubmitButton from '../../components/ui/SubmitButton.astro';
import {
  getAccessTokenFromCookies,
  getAuthSessionContext,
  isAuthorRole,
} from '../../lib/auth/session';
import { getMessages, resolveRequestLocale } from '../../lib/i18n';

const locale = resolveRequestLocale(Astro.cookies, Astro.url.pathname);
const t = getMessages(locale);

const accessToken = getAccessTokenFromCookies(Astro.cookies);
if (!accessToken) {
  return Astro.redirect('/auth/login?next=/me');
}

const session = await getAuthSessionContext(accessToken);
if (!session) {
  return Astro.redirect('/auth/login?error=invalid_credentials&next=/me');
}

const userEmail = session.user.email ?? '';
const canAccessAuthorArea = session.profile ? isAuthorRole(session.profile.role) : false;
const profileItems = session.profile ? [
  { label: t.authorDashboard.role, value: session.profile.role },
  { label: t.authorDashboard.language, value: session.profile.locale },
] : [];
---

<Layout title={`${t.nav.authorSpace} | A poc a poc i amb bona lletra`} description={t.authorDashboard.description}>
  <PageSection class="me-page">
    <PageHeader eyebrow={t.nav.signedInAs} title={userEmail} />
    {session.profile ? (
      <DefinitionGrid items={profileItems} variant="wide" />
    ) : (
      <EmptyState text={t.authorDashboard.noAuthorProfile} />
    )}

    <div class="actions">
      {canAccessAuthorArea && <ButtonLink href="/author" text={t.nav.authorSpace} />}
      <form method="post" action="/api/auth/logout">
        <SubmitButton text={t.nav.logout} variant="danger" />
      </form>
    </div>
  </PageSection>
</Layout>

<style lang="scss">
  .me-page {
    padding-block: var(--space-12);
  }

  :global(.me-page h1) {
    overflow-wrap: anywhere;
  }

  :global(.definition-grid) {
    margin: var(--space-6) 0;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }

</style>
