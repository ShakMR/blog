---
import type { SupportedLocale } from '../../config/site';
import type { PublicAuthor } from '../../lib/authors/public';
import { getAuthorNoun } from '../../lib/authors/utils';
import type { Messages } from '../../lib/i18n/types';
import type { StoryRecord } from '../../lib/stories/types';
import { formatDate, getStoryExcerpt, toPublicCoverUrl } from '../../lib/stories/utils';
import Divider, { Variants } from '../Divider.astro';
import PageSection from '../layout/PageSection.astro';
import EmptyState from '../ui/EmptyState.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import StoryCard from '../StoryCard.astro';

interface Props {
  title: string;
  emptyLabel: string;
  stories: StoryRecord[];
  authors: Map<string, PublicAuthor>;
  locale: SupportedLocale;
  labels: Messages['stories'];
}

const { title, emptyLabel, stories, authors, locale, labels } = Astro.props;
---

<PageSection class="feed">
  <SectionHeader title={title} />

  {stories.length === 0 ? (
    <EmptyState text={emptyLabel} />
  ) : (
    <ul class="stories-grid">
      {stories.map((story) => {
        const author = authors.get(story.author_id);
        const authorName = author?.display_name?.trim() || (author ? `@${author.slug}` : null);

        return (
          <li>
            <StoryCard
              title={story.title}
              subtitle={story.subtitle}
              excerpt={getStoryExcerpt(story.body_html, 145) || labels.excerptFallback}
              coverUrl={toPublicCoverUrl(story.cover_image_path)}
              coverAlt={`Portada de ${story.title}`}
              titleHref={`/stories/${story.slug}`}
              authorLabel={author ? getAuthorNoun(locale, author.grammatical_gender) : labels.author}
              authorValue={authorName}
              authorHref={author ? `/authors/${author.slug}` : null}
              publishedAtLabel={labels.publishedAt}
              publishedAtValue={formatDate(story.published_at, locale)}
              variant="row"
            />
            <Divider variant={Variants.LINE} />
          </li>
        );
      })}
    </ul>
  )}
</PageSection>

<style lang="scss">
  :global(.feed) {
    padding-bottom: var(--space-12);
  }

  .stories-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .stories-grid li {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
