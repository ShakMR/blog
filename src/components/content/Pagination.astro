---
import type { Messages } from '../../lib/i18n/types';

interface Props {
  page: number;
  hasPrev: boolean;
  hasNext: boolean;
  basePath?: string;
  labels: Messages['pagination'];
}

const { page, hasPrev, hasNext, basePath = '/stories', labels } = Astro.props;
const href = (target: number) => `${basePath}?page=${target}`;
---

<nav class="pagination" aria-label={labels.label}>
  {hasPrev ? (
    <a class="page-link" rel="prev" href={href(page - 1)}>← {labels.previous}</a>
  ) : (
    <span class="page-link disabled" aria-disabled="true">← {labels.previous}</span>
  )}

  <span class="current" aria-current="page">{labels.page.replace('{page}', String(page))}</span>

  {hasNext ? (
    <a class="page-link" rel="next" href={href(page + 1)}>{labels.next} →</a>
  ) : (
    <span class="page-link disabled" aria-disabled="true">{labels.next} →</span>
  )}
</nav>

<style lang="scss">
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .page-link {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    text-decoration: none;
    color: var(--color-accent);
    background: var(--color-surface);
  }

  .page-link:hover,
  .page-link:focus-visible {
    border-color: var(--color-accent);
  }

  .page-link.disabled {
    color: var(--color-text-muted);
    opacity: 0.5;
    pointer-events: none;
  }

  .current {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
