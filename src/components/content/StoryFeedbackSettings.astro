---
import type { Messages } from '../../lib/i18n/types';

type FeedbackLabels = Pick<
  Messages['editor'],
  | 'feedbackTitle'
  | 'feedbackDescription'
  | 'kudosVisibility'
  | 'kudosPrivate'
  | 'kudosPublic'
  | 'kudosDisabled'
  | 'commentsEnabled'
  | 'searchIndexing'
  | 'searchIndexingHint'
>;

interface Props {
  labels: FeedbackLabels;
  commentsEnabled: boolean;
  kudosVisibility: 'disabled' | 'private' | 'public';
  indexable: boolean;
}

const { labels, commentsEnabled, kudosVisibility, indexable } = Astro.props;
---

<section class="feedback-settings" aria-labelledby="feedback-title">
  <div>
    <h2 id="feedback-title">{labels.feedbackTitle}</h2>
    <p>{labels.feedbackDescription}</p>
  </div>

  <fieldset>
    <legend>{labels.kudosVisibility}</legend>
    <label class="option">
      <input type="radio" name="kudosVisibility" value="private" checked={kudosVisibility === 'private'} />
      <span>{labels.kudosPrivate}</span>
    </label>
    <label class="option">
      <input type="radio" name="kudosVisibility" value="public" checked={kudosVisibility === 'public'} />
      <span>{labels.kudosPublic}</span>
    </label>
    <label class="option">
      <input type="radio" name="kudosVisibility" value="disabled" checked={kudosVisibility === 'disabled'} />
      <span>{labels.kudosDisabled}</span>
    </label>
  </fieldset>

  <label class="option">
    <input type="hidden" name="commentsEnabled" value="false" />
    <input type="checkbox" name="commentsEnabled" value="true" checked={commentsEnabled} />
    <span>{labels.commentsEnabled}</span>
  </label>

  <div class="indexing">
    <label class="option">
      <input type="hidden" name="indexable" value="false" />
      <input type="checkbox" name="indexable" value="true" checked={indexable} />
      <span>{labels.searchIndexing}</span>
    </label>
    <p class="hint">{labels.searchIndexingHint}</p>
  </div>
</section>

<style lang="scss">
  .feedback-settings {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  h2,
  p,
  fieldset {
    margin: 0;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  p {
    color: var(--color-text-muted);
  }

  fieldset {
    border: 0;
    display: grid;
    gap: var(--space-2);
    padding: 0;
  }

  legend {
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .option {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .option input {
    flex: 0 0 auto;
    margin: 0;
  }

  .indexing {
    display: grid;
    gap: var(--space-1);
  }

  .hint {
    margin: 0;
    padding-left: calc(1rem + var(--space-2));
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
</style>
