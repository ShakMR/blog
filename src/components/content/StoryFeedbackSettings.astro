---
import type { Messages } from '../../lib/i18n/types';
import Label from '../Label.astro';

type FeedbackLabels = Pick<
  Messages['editor'],
  | 'feedbackTitle'
  | 'feedbackDescription'
  | 'kudosVisibility'
  | 'kudosPrivate'
  | 'kudosPublic'
  | 'kudosDisabled'
  | 'commentsEnabled'
>;

interface Props {
  labels: FeedbackLabels;
  commentsEnabled: boolean;
  kudosVisibility: 'disabled' | 'private' | 'public';
}

const { labels, commentsEnabled, kudosVisibility } = Astro.props;
---

<section class="feedback-settings" aria-labelledby="feedback-title">
  <div>
    <h2 id="feedback-title">{labels.feedbackTitle}</h2>
    <p>{labels.feedbackDescription}</p>
  </div>

  <fieldset>
    <legend>{labels.kudosVisibility}</legend>
    <Label>
      <input type="radio" name="kudosVisibility" value="private" checked={kudosVisibility === 'private'} />
      {labels.kudosPrivate}
    </Label>
    <Label>
      <input type="radio" name="kudosVisibility" value="public" checked={kudosVisibility === 'public'} />
      {labels.kudosPublic}
    </Label>
    <Label>
      <input type="radio" name="kudosVisibility" value="disabled" checked={kudosVisibility === 'disabled'} />
      {labels.kudosDisabled}
    </Label>
  </fieldset>

  <Label>
    <input type="hidden" name="commentsEnabled" value="false" />
    <input type="checkbox" name="commentsEnabled" value="true" checked={commentsEnabled} />
    {labels.commentsEnabled}
  </Label>
</section>

<style lang="scss">
  .feedback-settings {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  h2,
  p,
  fieldset {
    margin: 0;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  p {
    color: var(--color-text-muted);
  }

  fieldset {
    border: 0;
    display: grid;
    gap: var(--space-2);
    padding: 0;
  }

  legend {
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  label {
    display: flex;
    gap: var(--space-2);
  }
</style>
