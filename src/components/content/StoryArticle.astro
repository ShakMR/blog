---
import type { StoryRecord } from '../../lib/stories/types';
import EmptyState from '../ui/EmptyState.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import PageHeader from '../ui/PageHeader.astro';

interface Props {
  story: StoryRecord | null;
  notFoundLabel: string;
  coverUrl?: string | null;
  coverAlt?: string;
  eyebrow?: string;
  meta?: string;
  authorLabel?: string;
  authorName?: string;
  authorHref?: string | null;
  authorHandle?: string | null;
  authorBio?: string;
}

const {
  story,
  notFoundLabel,
  coverUrl = null,
  coverAlt,
  eyebrow,
  meta,
  authorLabel,
  authorName,
  authorHref = null,
  authorHandle = null,
  authorBio,
} = Astro.props;

const hasAuthor = Boolean(authorLabel && authorName && authorBio);
---

{story ? (
  <div class:list={['story-layout', !hasAuthor && 'single']}>
    <article>
      {coverUrl && <img src={coverUrl} alt={coverAlt || story.title} class="cover" loading="lazy" />}
      <PageHeader title={story.title} eyebrow={eyebrow} description={story.subtitle}>
        {meta && <p class="meta">{meta}</p>}
      </PageHeader>

      {story.tags.length > 0 && (
        <div class="tags">
          {story.tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}

      <div class="content" set:html={story.body_html}></div>
    </article>

    {hasAuthor && (
      <aside class="author-card">
        <Eyebrow text={authorLabel!} />
        <p class="author-name">
          {authorHref ? <a href={authorHref}>{authorName}</a> : authorName}
        </p>
        {authorHandle && <p class="author-handle">{authorHandle}</p>}
        <p class="author-bio">{authorBio}</p>
      </aside>
    )}
  </div>
) : (
  <EmptyState text={notFoundLabel} />
)}

<style lang="scss">
  .story-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: var(--space-8);
    align-items: start;
  }

  .story-layout.single {
    grid-template-columns: 1fr;
  }

  article {
    max-width: 720px;
  }

  .cover {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  article :global(.page-header) {
    gap: var(--space-2);
  }

  article :global(.page-header h1) {
    font-size: clamp(2rem, 5vw, 3.3rem);
  }

  article :global(.page-header p) {
    margin-bottom: var(--space-4);
  }

  article :global(.page-header .eyebrow) {
    margin-bottom: var(--space-2);
  }

  .meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .tags {
    margin-block: var(--space-4) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tags span {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-size: 0.8rem;
  }

  .content :global(p) {
    line-height: 1.8;
  }

  .author-card {
    position: sticky;
    top: 5.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-4);
  }

  .author-name {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .author-name a {
    text-decoration: none;
  }

  .author-handle {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .author-bio {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .story-layout {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .author-card {
      position: static;
    }
  }
</style>
