---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="section-header">
  <h2>{title}</h2>
  <slot />
</header>

<style lang="scss">
  .section-header {
    margin: 0 0 var(--space-4);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }
</style>
