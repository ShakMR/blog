---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<p class="eyebrow">{text}</p>

<style lang="scss">
  .eyebrow {
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }
</style>
