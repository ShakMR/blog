---
interface Props {
  text?: string;
  tone?: 'ok' | 'error';
}

const { text, tone = 'ok' } = Astro.props;
---

<p class:list={['message', tone]}>
  <slot>{text}</slot>
</p>

<style lang="scss">
  .message {
    margin: var(--space-4) 0 0;
    border-radius: var(--radius-md);
    padding: 0.8rem 0.95rem;
  }

  .message.ok {
    background: rgba(40, 132, 73, 0.1);
    color: #20592f;
  }

  .message.error {
    background: rgba(148, 46, 46, 0.1);
    color: #7d2020;
  }
</style>
