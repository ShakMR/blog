---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<section class="panel" aria-label={title}>
  {title && <h2>{title}</h2>}
  <slot />
</section>

<style lang="scss">
  .panel {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--color-surface);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
  }
</style>
