---
interface Props {
  title: string;
  subtitle: string;
  coverUrl?: string | null;
  coverAlt: string;
  titleHref?: string;
  statusLabel?: string;
  publishedAtLabel?: string;
  publishedAtValue?: string | null;
  updatedAtLabel?: string;
  updatedAtValue?: string | null;
  variant?: 'row' | 'column';
}

const {
  title,
  subtitle,
  coverUrl = null,
  coverAlt,
  titleHref,
  statusLabel,
  publishedAtLabel,
  publishedAtValue,
  updatedAtLabel,
  updatedAtValue,
  variant = 'column',
} = Astro.props;

const hasActions = Astro.slots.has('actions');
---

<article class:list={['story-card', variant]}>
  {coverUrl && <img src={coverUrl} alt={coverAlt} loading="lazy" />}
  <div class="story-content">
    {statusLabel && <p class="pill">{statusLabel}</p>}
    <h3>{titleHref ? <a href={titleHref}>{title}</a> : title}</h3>
    <p>{subtitle}</p>
    {publishedAtLabel && publishedAtValue && <p class="meta">{publishedAtLabel}: {publishedAtValue}</p>}
    {updatedAtLabel && updatedAtValue && <p class="meta">{updatedAtLabel}: {updatedAtValue}</p>}
    {hasActions && (
      <div class="actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</article>

<style lang="scss">
  .story-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    display: grid;
    gap: var(--space-4);
  }

  .story-card.column {
    grid-template-columns: 1fr;
  }

  .story-card.row {
    grid-template-columns: 160px 1fr;
  }

  .story-card img {
    width: 100%;
    height: 100%;
    min-height: 180px;
    object-fit: cover;
  }

  .story-content {
    padding: var(--space-4);
  }

  .story-content h3 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
  }

  .story-content h3 a {
    text-decoration: none;
  }

  .pill {
    display: inline-flex;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: #7f3025;
    margin: 0;
  }

  .meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .actions :global(a),
  .actions :global(button) {
    font: inherit;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .story-card.row {
      grid-template-columns: 1fr;
    }
  }
</style>
