---
import {isSameDay} from '../lib/dates/isSameDay';
interface Props {
  title: string;
  subtitle: string;
  excerpt?: string;
  coverUrl?: string | null;
  coverAlt: string;
  titleHref?: string;
  statusLabel?: string;
  authorLabel?: string;
  authorValue?: string | null;
  publishedAtLabel?: string;
  publishedAtValue?: string | null;
  updatedAtLabel?: string;
  updatedAtValue?: string | null;
  variant?: 'row' | 'column';
}

const {
  title,
  subtitle,
  excerpt = '',
  coverUrl = null,
  coverAlt,
  titleHref,
  statusLabel,
  authorLabel,
  authorValue,
  publishedAtLabel,
  publishedAtValue,
  updatedAtLabel,
  updatedAtValue,
  variant = 'column',
} = Astro.props;

const hasActions = Astro.slots.has('actions');
const publishedAndEditedSameDay = publishedAtValue && updatedAtValue ? isSameDay(publishedAtValue, updatedAtValue)  : false;
const shouldShowPublishDate = !!publishedAtLabel && !!publishedAtValue;
const shouldShowUpdateDate = !!updatedAtLabel && !!updatedAtValue && publishedAndEditedSameDay
---

<article class:list={['story-card', variant]}>
  {coverUrl && <img src={coverUrl} alt={coverAlt} loading="lazy" />}
  <div class="story-content">
    {statusLabel && <p class="pill">{statusLabel}</p>}
    <h3>{titleHref ? <a href={titleHref}>{title}</a> : title}</h3>
    <p class="subtitle">{subtitle}</p>
    {excerpt && <p class="excerpt">{excerpt}</p>}

    <div class="meta-grid">
      {authorLabel && authorValue && <p class="meta">{authorLabel}: {authorValue}</p>}
      {shouldShowPublishDate && <p class="meta">{publishedAtLabel}: {publishedAtValue}</p>}
      {shouldShowUpdateDate && <p class="meta">{updatedAtLabel}: {updatedAtValue}</p>}
    </div>

    {hasActions && (
      <div class="actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</article>

<style lang="scss">
  .story-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    display: grid;
  }

  .story-card.column {
    grid-template-columns: 1fr 300px;
  }

  .story-card.row {
    grid-template-columns: 300px 1fr;
  }

  .story-card img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .story-content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  .story-content h3 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
    line-height: 1.2;
  }

  .story-content h3 a {
    text-decoration: none;
  }

  .subtitle {
    margin: 0;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .excerpt {
    margin: var(--space-2) 0 0;
    color: var(--color-text);
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-card.column .story-content .meta-grid {
    margin-top: 1rem;
  }

  .meta-grid {
    margin-top: auto;
    display: grid;
    gap: 0.2rem;
  }

  .pill {
    display: inline-flex;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: #7f3025;
    margin: 0;
  }

  .meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .actions :global(a),
  .actions :global(button) {
    font: inherit;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .story-card.row {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 300px;
    }
  }
</style>
