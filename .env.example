PUBLIC_DEFAULT_LOCALE=es
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-side only values
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_DB_PASSWORD=postgres
GMAIL_RELAY_URL=
GMAIL_RELAY_TOKEN=
GMAIL_RELAY_FROM_EMAIL=
GMAIL_RELAY_FROM_NAME=
GMAIL_RELAY_TIMEOUT_MS=10000
