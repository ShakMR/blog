# Public client values (safe for browser)
PUBLIC_APP_URL=http://localhost:4321
PUBLIC_DEFAULT_LOCALE=es
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-side only values
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_DB_PASSWORD=postgres
# Optional: dedicated HMAC key for the comment anti-spam challenge.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
COMMENT_CHALLENGE_SECRET=
# Invite email delivery via Resend (https://resend.com).
# When both are set, author invites are emailed automatically; otherwise the
# admin sees a ready-to-send draft to deliver manually.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TIMEOUT_MS=10000
